# HTTPS in front of the API (PWA-190). Caddy gets and renews the Let's Encrypt certificate on its
# own, and sends plain HTTP (port 80) to HTTPS.
{$API_DOMAIN} {
	encode zstd gzip

	# /health runs a database query on every call: only Docker's healthcheck needs it, and that one
	# goes straight to the container (127.0.0.1:3000). Not exposed, so nobody can use it to tie up
	# the connection pool. From outside, GET / (no database) says the API is up. With * because
	# Express also routes /health/ (trailing slash) to it.
	respond /health* 404

	# Caddy replaces any X-Forwarded-For the client sends with its real IP; the app trusts this one
	# proxy (TRUST_PROXY=1), so the request limits can't be dodged by faking the header.
	reverse_proxy api:3000

	# Without the "Server: Caddy" header.
	header -Server

	log
}
