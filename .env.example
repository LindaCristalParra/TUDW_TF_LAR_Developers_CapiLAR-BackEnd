# Server
PORT=3000

# Database (Docker MySQL container)
DB_ROOT_PASSWORD=change-me
DB_NAME=capilar_db
DB_PORT=3306

# Database connection used by Prisma
# Use the same password as DB_ROOT_PASSWORD and the same port as DB_PORT
DATABASE_URL="mysql://root:change-me@localhost:3306/capilar_db?allowPublicKeyRetrieval=true"

# Auth (JWT)
JWT_SECRET="change-me"
# Short-lived access token; the session is renewed with POST /auth/refresh
JWT_EXPIRES_IN="15m"
# Refresh token: its own secret (different from JWT_SECRET) and how many days it lasts
JWT_REFRESH_SECRET="change-me-too"
REFRESH_EXPIRES_DAYS=7
# true when front and back are on different sites over HTTPS (cookie SameSite=None; Secure).
# false on localhost (SameSite=Lax over http).
COOKIE_SECURE=false

#email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=tucuenta@gmail.com
SMTP_PASS=laclavede16caracteres
MAIL_FROM="CapiLAR <tucuenta@gmail.com>"
FRONTEND_URL=http://localhost:5173

# First admin, created by `npx prisma db seed` (skipped if the email already exists)
ADMIN_EMAIL=admin@capilar.com
ADMIN_PASSWORD=change-me-1234
ADMIN_TELEFONO=

# CORS: allowed front-end origins, comma-separated, no trailing slash
CORS_ORIGINS=http://localhost:5173

# Folder for profile photos (optional, defaults to "uploads" in the project root)
UPLOADS_DIR=uploads
